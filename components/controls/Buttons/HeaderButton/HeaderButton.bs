import "pkg:/source/Remote.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/TextMeasurement.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeFont.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("bg")
    m.iconPoster = m.top.findNode("icon")
    m.textLabel = m.top.findNode("textLabel")
    m.measurementLabel = CreateObject("roSGNode", "Label")
    m.themePalette = Theme.HeaderButton(m.global.theme)
    m.background.uri = m.themePalette.focusedUri
    if m.top.headerBgColor = 0 then m.top.headerBgColor = &h12112BFF
    m.top.observeField("focusedChild", "onFocusChanged")
    m.global.observeFieldScoped("theme", "updateTheme")
    ThemeFont.Apply(m.top, m.global.theme)
    onDimensionsChanged()
    onTextLayoutChanged()
    onTextChanged()
    onIconUriChanged()
    onFocusVisualChanged()
end sub

'-------------------------------------------------------------------------------
' onTextChanged
'-------------------------------------------------------------------------------
sub onTextChanged()
    m.textLabel.text = m.top.text
    onTextLayoutChanged()
end sub

'-------------------------------------------------------------------------------
' onIconUriChanged
'-------------------------------------------------------------------------------
sub onIconUriChanged()
    m.iconPoster.uri = m.top.iconUri
    m.iconPoster.visible = m.top.iconUri <> invalid and m.top.iconUri <> ""
    onTextLayoutChanged()
end sub

'-------------------------------------------------------------------------------
' onDimensionsChanged
'-------------------------------------------------------------------------------
sub onDimensionsChanged()
    width = getButtonWidth()
    height = getButtonHeight()

    m.background.width = width
    m.background.height = height

    updateTextLayout(width, height)
end sub

'-------------------------------------------------------------------------------
' onTextLayoutChanged
'-------------------------------------------------------------------------------
sub onTextLayoutChanged()
    updateTextLayout(getButtonWidth(), getButtonHeight())
end sub

'-------------------------------------------------------------------------------
' updateTextLayout
'-------------------------------------------------------------------------------
sub updateTextLayout(width as integer, height as integer)
    inset = Number.ToInteger(m.top.textInset, 0)
    if inset < 0 then inset = 0
    if inset * 2 >= width then inset = 0

    textY = Number.ToInteger((height - 28) / 2, 0)
    if m.iconPoster.visible then
        layoutIconAndText(width, height, inset, textY)
    else
        m.textLabel.horizAlign = getTextAlign()
        m.textLabel.width = width - (inset * 2)
        m.textLabel.translation = [inset, textY]
    end if
end sub

'-------------------------------------------------------------------------------
' layoutIconAndText
'-------------------------------------------------------------------------------
sub layoutIconAndText(width as integer, height as integer, inset as integer, textY as integer)
    iconHeight = 22
    iconWidth = Number.ToInteger(m.top.iconWidth, 22)
    if iconWidth < 1 then iconWidth = 22
    iconSlotWidth = Number.ToInteger(m.top.iconSlotWidth, 0)
    if iconSlotWidth < iconWidth then iconSlotWidth = iconWidth
    iconGap = 10
    textWidth = TextMeasurement.GetWidth(m.measurementLabel, m.textLabel.font, m.top.text) + 8
    maxTextWidth = width - (inset * 2) - iconSlotWidth - iconGap
    if maxTextWidth < 1 then maxTextWidth = 1
    if textWidth > maxTextWidth then textWidth = maxTextWidth

    contentWidth = iconSlotWidth + iconGap + textWidth
    contentX = Number.ToInteger((width - contentWidth) / 2, 0)
    if getTextAlign() = "left" then contentX = inset
    if contentX < inset then contentX = inset

    m.iconPoster.width = iconWidth
    m.iconPoster.height = iconHeight
    iconX = contentX + Number.ToInteger((iconSlotWidth - iconWidth) / 2, 0)
    m.iconPoster.translation = [iconX, Number.ToInteger((height - iconHeight) / 2, 0)]
    m.textLabel.horizAlign = "left"
    m.textLabel.width = textWidth
    m.textLabel.translation = [contentX + iconSlotWidth + iconGap, textY]
end sub

'-------------------------------------------------------------------------------
' getTextAlign
'-------------------------------------------------------------------------------
function getTextAlign() as string
    align = LCase(m.top.textAlign)
    if align = "left" or align = "right" then return align
    return "center"
end function

'-------------------------------------------------------------------------------
' getButtonWidth
'-------------------------------------------------------------------------------
function getButtonWidth() as integer
    width = Number.ToInteger(m.top.buttonWidth, 300)
    if width > 0 then return width
    return 300
end function

'-------------------------------------------------------------------------------
' getButtonHeight
'-------------------------------------------------------------------------------
function getButtonHeight() as integer
    height = Number.ToInteger(m.top.buttonHeight, 56)
    if height > 0 then return height
    return 56
end function

'-------------------------------------------------------------------------------
' onFocusVisualChanged
'-------------------------------------------------------------------------------
sub onFocusVisualChanged()
    hasFocusVisual = m.top.hasFocusVisual = true
    hasActiveVisual = m.top.hasActiveVisual = true

    if hasFocusVisual then
        m.background.visible = true
        m.background.opacity = 1
    else if hasActiveVisual then
        m.background.visible = m.themePalette.activeOpacity > 0
        m.background.opacity = m.themePalette.activeOpacity
    else
        m.background.visible = false
        m.background.opacity = 1
    end if

    if hasFocusVisual or (hasActiveVisual and m.themePalette.activeUsesFocusedText) then
        m.textLabel.color = m.top.headerBgColor
    else if hasActiveVisual then
        m.textLabel.color = &hFFFFFFFF
    else
        m.textLabel.color = m.themePalette.text
    end if
    m.iconPoster.blendColor = m.textLabel.color
end sub

'-------------------------------------------------------------------------------
' updateTheme
'-------------------------------------------------------------------------------
sub updateTheme()
    m.themePalette = Theme.HeaderButton(m.global.theme)
    m.background.uri = m.themePalette.focusedUri
    ThemeFont.Apply(m.top, m.global.theme)
    onTextLayoutChanged()
    onFocusVisualChanged()
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    m.top.hasFocusVisual = m.top.isInFocusChain()
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = Remote.Key.OK or key = Remote.Key.Select then
        m.top.buttonSelected = true
        return true
    end if

    return false
end function
