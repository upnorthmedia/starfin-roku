import "pkg:/source/String.bs"
import "pkg:/source/Remote.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeFont.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("background")
    m.sortLabel = m.top.findNode("sortLabel")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.global.observeField("theme", "updateFocusVisual")
    ThemeFont.Apply(m.top, m.global.theme)
    updateSortDisplay()
    updateFocusVisual()
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    updateFocusVisual()
end sub

'-------------------------------------------------------------------------------
' updateFocusVisual
'-------------------------------------------------------------------------------
sub updateFocusVisual()
    hasFocus = m.top.isInFocusChain()
    palette = Theme.Button(m.global.theme)

    if hasFocus then
        m.background.uri = palette.focusedUri
        m.sortLabel.color = palette.focusedText
    else
        m.background.uri = palette.unfocusedUri
        m.sortLabel.color = palette.text
    end if
end sub

'-------------------------------------------------------------------------------
' onSelectedSortChanged
'-------------------------------------------------------------------------------
sub onSelectedSortChanged()
    updateSortDisplay()
end sub

'-------------------------------------------------------------------------------
' updateSortDisplay
'-------------------------------------------------------------------------------
sub updateSortDisplay()
    selection = getSelectedSort()
    m.sortLabel.text = getSortDisplayText(selection)
end sub

'-------------------------------------------------------------------------------
' getSelectedSort
'-------------------------------------------------------------------------------
function getSelectedSort() as object
    if m.top.selectedSort <> invalid then return m.top.selectedSort

    return {
        optionKey: "SortName"
        sortKey: "SortName"
        sortOrder: "Ascending"
        label: "Title"
    }
end function

'-------------------------------------------------------------------------------
' getSortDisplayText
'-------------------------------------------------------------------------------
function getSortDisplayText(selection as object) as string
    label = Strings.ToString(selection.label)
    if label <> "" then return label

    return "Title"
end function

'-------------------------------------------------------------------------------
' openBrowseDialog
'-------------------------------------------------------------------------------
sub openBrowseDialog()
    m.top.overlayRequested = {
        id: "sort"
        componentName: "BrowseDialog"
        openFunction: "openBrowse"
        closeFields: ["closeRequested", "sortSelected"]
    }
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = Remote.Key.OK or key = Remote.Key.Select then
        openBrowseDialog()
        return true
    end if

    if key = Remote.Key.Down or key = Remote.Key.Back then
        m.top.focusExitDown = true
        return true
    end if

    return false
end function
