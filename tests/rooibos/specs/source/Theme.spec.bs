namespace tests

    @suite("Theme values")
    class ThemeTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalProfile = m.global.resolutionProfile
            if not m.global.hasField("resolutionProfile") then m.global.addField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }
        end function

        protected override function afterEach()
            m.global.resolutionProfile = m.originalProfile
        end function

        @describe("Account badge palette")

        @it("provides the blue badge palette")
        function _()
            palette = Theme.AccountBadge("blue")

            m.assertEqual(palette.background, &h12112BFF)
            m.assertEqual(palette.ring, &h010D29FF)
            m.assertEqual(palette.glass, &hE1E8F7FF)
        end function

        @it("provides the black badge palette")
        function _()
            palette = Theme.AccountBadge("black")

            m.assertEqual(palette.background, &h0B0B0BFF)
            m.assertEqual(palette.ring, &h121212FF)
            m.assertEqual(palette.glass, &hE8E8E8FF)
        end function

        @it("provides the grey badge palette")
        function _()
            palette = Theme.AccountBadge("grey")

            m.assertEqual(palette.background, &h2D2C2CFF)
            m.assertEqual(palette.ring, &h343434FF)
            m.assertEqual(palette.glass, &hE8E8E8FF)
        end function

        @it("provides the unknown badge palette")
        function _()
            palette = Theme.AccountBadge("unknown")

            m.assertEqual(palette.background, &h12112BFF)
            m.assertEqual(palette.ring, &h010D29FF)
            m.assertEqual(palette.glass, &hE1E8F7FF)
        end function

        @describe("Square button palette")

        @it("resolves blue square button palette")
        function _()
            palette = Theme.SquareButton("blue")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/blue/square-button-background.png")
            m.assertEqual(palette.wideFill, &h092452FF)
            m.assertEqual(palette.focusedText, &h0F1A2AFF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves black square button palette")
        function _()
            palette = Theme.SquareButton("black")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/black/square-button-background.png")
            m.assertEqual(palette.wideFill, &h262626FF)
            m.assertEqual(palette.focusedText, &h121212FF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves grey square button palette")
        function _()
            palette = Theme.SquareButton("grey")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/grey/square-button-background.png")
            m.assertEqual(palette.wideFill, &h4A4A4AFF)
            m.assertEqual(palette.focusedText, &h242424FF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves unknown square button palette")
        function _()
            palette = Theme.SquareButton("unknown")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/blue/square-button-background.png")
            m.assertEqual(palette.wideFill, &h092452FF)
            m.assertEqual(palette.focusedText, &h0F1A2AFF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @describe("Dialog panels")

        @it("resolves blue dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("blue"), "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("resolves blue dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("blue"), "pkg:/images/themes/blue/hd/dialog-panel.9.png")
        end function

        @it("resolves black dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("black"), "pkg:/images/themes/black/fhd/dialog-panel.9.png")
        end function

        @it("resolves black dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("black"), "pkg:/images/themes/black/hd/dialog-panel.9.png")
        end function

        @it("resolves grey dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("grey"), "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
        end function

        @it("resolves grey dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("grey"), "pkg:/images/themes/grey/hd/dialog-panel.9.png")
        end function

        @it("resolves unknown dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("unknown"), "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("resolves unknown dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("unknown"), "pkg:/images/themes/blue/hd/dialog-panel.9.png")
        end function

        @describe("Theme selection")

        @it("normalizes blue regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("BLUE"), "blue")
        end function

        @it("normalizes black regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("BLACK"), "black")
        end function

        @it("normalizes grey regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("GREY"), "grey")
        end function

        @it("defaults missing preferences to blue")
        function _()
            m.assertEqual(Theme.Normalize(invalid), "blue")
        end function

        @it("defaults unsupported preferences to blue")
        function _()
            m.assertEqual(Theme.Normalize("unknown"), "blue")
        end function

        @it("provides the background color for blue")
        function _()
            m.assertEqual(Theme.BackgroundColor("blue"), &h000000FF)
        end function

        @it("provides the background color for black")
        function _()
            m.assertEqual(Theme.BackgroundColor("black"), &h121212FF)
        end function

        @it("provides the background color for grey")
        function _()
            m.assertEqual(Theme.BackgroundColor("grey"), &h343434FF)
        end function

        @it("provides the background color for unknown")
        function _()
            m.assertEqual(Theme.BackgroundColor("unknown"), &h000000FF)
        end function

        @it("provides the gradient image for blue")
        function _()
            m.assertEqual(Theme.BackgroundUri("blue"), "pkg:/images/themes/blue/background.png")
        end function

        @it("provides the gradient image for black")
        function _()
            m.assertEqual(Theme.BackgroundUri("black"), "pkg:/images/themes/black/background.png")
        end function

        @it("provides the gradient image for grey")
        function _()
            m.assertEqual(Theme.BackgroundUri("grey"), "pkg:/images/themes/grey/background.png")
        end function

        @it("provides the gradient image for unknown")
        function _()
            m.assertEqual(Theme.BackgroundUri("unknown"), "pkg:/images/themes/blue/background.png")
        end function

        @it("resolves blue menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("blue")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/blue/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/blue/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h12112BFF)
        end function

        @it("resolves blue menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("blue")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/blue/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/blue/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h12112BFF)
        end function

        @it("resolves black menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("black")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/black/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/black/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h121212FF)
        end function

        @it("resolves black menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("black")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/black/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/black/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h121212FF)
        end function

        @it("resolves grey menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("grey")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/grey/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/grey/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h242424FF)
        end function

        @it("resolves grey menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("grey")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/grey/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/grey/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h242424FF)
        end function

        @it("returns the default theme and required color groups")
        function _()
            themeValues = Theme.Get()
            m.assertNotInvalid(themeValues.background)
            m.assertNotInvalid(themeValues.text)
            m.assertNotInvalid(themeValues.accent)
            m.assertNotInvalid(themeValues.control)
            m.assertEqual(themeValues.background.header, &h12112BFF)
            m.assertEqual(themeValues.text.light.primary, &hF3F7FBFF)
            m.assertEqual(themeValues.accent.primary, &hE09B42FF)
            m.assertEqual(themeValues.control.inputFocus, &h21405EFF)
        end function

        @it("falls back to the default theme for unknown names")
        function _()
            m.assertEqual(Theme.Get("Unknown"), Theme.Get("Default"))
        end function

        @describe("Pure Black")

        @it("normalizes the pure-black registry value case-insensitively")
        function _()
            m.assertEqual(Theme.Normalize("PURE-BLACK"), "pure-black")
        end function

        @it("uses opaque black without a background image")
        function _()
            m.assertEqual(Theme.BackgroundColor("pure-black"), &h000000FF)
            m.assertEqual(Theme.BackgroundUri("pure-black"), "")
        end function

        @it("matches the account badge matte to pure black")
        function _()
            palette = Theme.AccountBadge("pure-black")

            m.assertEqual(palette.background, &h000000FF)
            m.assertEqual(palette.ring, &h121212FF)
            m.assertEqual(palette.glass, &hE8E8E8FF)
        end function

        @it("reuses Black square button styling")
        function _()
            m.assertEqual(Theme.SquareButton("pure-black"), Theme.SquareButton("black"))
        end function

        @it("reuses Black detailed card styling")
        function _()
            m.assertEqual(Theme.DetailedCardBackgroundUri("pure-black"), Theme.DetailedCardBackgroundUri("black"))
        end function

        @it("reuses Black header menu styling")
        function _()
            m.assertEqual(Theme.HeaderMenu("pure-black"), Theme.HeaderMenu("black"))
        end function

        @it("resolves the FHD pure-black dialog panel")
        function _()
            m.assertEqual(Theme.DialogPanelUri("pure-black"), "pkg:/images/themes/pure-black/fhd/dialog-panel.9.png")
        end function

        @it("resolves the HD pure-black dialog panel")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("pure-black"), "pkg:/images/themes/pure-black/hd/dialog-panel.9.png")
        end function


        @describe("Liquid Glass and Cinema")

        @it("normalizes the skin registry values case-insensitively")
        function _()
            m.assertEqual(Theme.Normalize("LIQUID-GLASS"), "liquid-glass")
            m.assertEqual(Theme.Normalize("Cinema"), "cinema")
        end function

        @it("identifies only the two skins")
        function _()
            m.assertTrue(Theme.IsSkin("liquid-glass"))
            m.assertTrue(Theme.IsSkin("cinema"))
            m.assertFalse(Theme.IsSkin("blue"))
            m.assertFalse(Theme.IsSkin("pure-black"))
        end function

        @it("provides the skin backgrounds")
        function _()
            m.assertEqual(Theme.BackgroundColor("liquid-glass"), &h0C1018FF)
            m.assertEqual(Theme.BackgroundColor("cinema"), &h141414FF)
            m.assertEqual(Theme.BackgroundUri("liquid-glass"), "pkg:/images/themes/liquid-glass/background.png")
            m.assertEqual(Theme.BackgroundUri("cinema"), "pkg:/images/themes/cinema/background.png")
        end function

        @it("resolves the skin dialog panels for fhd and hd")
        function _()
            m.assertEqual(Theme.DialogPanelUri("liquid-glass"), "pkg:/images/themes/liquid-glass/fhd/dialog-panel.9.png")
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("cinema"), "pkg:/images/themes/cinema/hd/dialog-panel.9.png")
        end function

        @it("resolves the skin header menus")
        function _()
            glass = Theme.HeaderMenu("liquid-glass")
            cinema = Theme.HeaderMenu("cinema")

            m.assertEqual(glass.fillUri, "pkg:/images/themes/liquid-glass/fhd/header-menu-fill.9.png")
            m.assertEqual(glass.glassUri, "pkg:/images/themes/liquid-glass/fhd/header-menu-glass.9.png")
            m.assertEqual(glass.focusedText, &h141A2BFF)
            m.assertEqual(glass.divider, &hFFFFFF33)
            m.assertEqual(cinema.fillUri, "pkg:/images/themes/cinema/fhd/header-menu-fill.9.png")
            m.assertEqual(cinema.focusedText, &h000000FF)
        end function

        @it("resolves the skin square buttons")
        function _()
            glass = Theme.SquareButton("liquid-glass")
            cinema = Theme.SquareButton("cinema")

            m.assertEqual(glass.backgroundUri, "pkg:/images/themes/liquid-glass/square-button-background.png")
            m.assertEqual(glass.wideFill, &h3A4152FF)
            m.assertEqual(glass.focusedText, &h141A2BFF)
            m.assertEqual(cinema.backgroundUri, "pkg:/images/themes/cinema/square-button-background.png")
            m.assertEqual(cinema.wideFill, &h2A2A2AFF)
            m.assertEqual(cinema.focusedText, &h000000FF)
        end function

        @it("resolves the skin detailed card panels and account badges")
        function _()
            m.assertEqual(Theme.DetailedCardBackgroundUri("liquid-glass"), "pkg:/images/themes/liquid-glass/detailed-card-panel.png")
            m.assertEqual(Theme.DetailedCardBackgroundUri("cinema"), "pkg:/images/themes/cinema/detailed-card-panel.png")
            m.assertEqual(Theme.AccountBadge("liquid-glass"), { background: &h0C1018FF, ring: &h1C2436FF, glass: &hE8ECF4FF })
            m.assertEqual(Theme.AccountBadge("cinema"), { background: &h141414FF, ring: &h232323FF, glass: &hE5E5E5FF })
        end function

        @it("keeps Blue's navigation glass for the original themes")
        function _()
            for each mode in ["blue", "black", "grey", "pure-black", "unknown"]
                m.assertEqual(Theme.NavGlassUri(mode), "pkg:/images/themes/blue/fhd/header-menu-glass.9.png")
            end for
        end function

        @it("gives Liquid Glass its own navigation glass and hides it for Cinema")
        function _()
            m.assertEqual(Theme.NavGlassUri("liquid-glass"), "pkg:/images/themes/liquid-glass/fhd/nav-glass.9.png")
            m.assertEqual(Theme.NavGlassUri("cinema"), "")
        end function

        @it("keeps the shared header button art for the original themes")
        function _()
            palette = Theme.HeaderButton("grey")

            m.assertEqual(palette.focusedUri, "pkg:/images/buttons/fhd/header-button-focused.9.png")
            m.assertEqual(palette.activeOpacity, 0.58)
            m.assertEqual(palette.text, &hFFFFFFFF)
            m.assertTrue(palette.activeUsesFocusedText)
        end function

        @it("styles Cinema header buttons as plain text")
        function _()
            palette = Theme.HeaderButton("cinema")

            m.assertEqual(palette.focusedUri, "pkg:/images/themes/cinema/fhd/header-button-focused.9.png")
            m.assertEqual(palette.activeOpacity, 0.0)
            m.assertEqual(palette.text, &hB3B3B3FF)
            m.assertFalse(palette.activeUsesFocusedText)
        end function

        @it("keeps the shared settings card and primary button art for the original themes")
        function _()
            button = Theme.Button("black")

            m.assertEqual(Theme.SettingsCardUri("black"), "pkg:/images/settings/fhd/settings-card-glass.9.png")
            m.assertEqual(button.unfocusedUri, "pkg:/images/buttons/fhd/primary-unfocused.9.png")
            m.assertEqual(button.focusedUri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(button.focusedText, &h0F1A2AFF)
            m.assertEqual(button.text, &hFFFFFFFF)
        end function

        @it("resolves the skin settings cards and primary buttons")
        function _()
            glass = Theme.Button("liquid-glass")
            cinema = Theme.Button("cinema")

            m.assertEqual(Theme.SettingsCardUri("cinema"), "pkg:/images/themes/cinema/fhd/card.9.png")
            m.assertEqual(glass.unfocusedUri, "pkg:/images/themes/liquid-glass/fhd/button.9.png")
            m.assertEqual(glass.focusedUri, "pkg:/images/themes/liquid-glass/fhd/button-focused.9.png")
            m.assertEqual(glass.focusedText, &h141A2BFF)
            m.assertEqual(cinema.focusedText, &h000000FF)
        end function

        @it("keeps the shared toolbar pills for the original themes and swaps them for skins")
        function _()
            m.assertEqual(Theme.ToolbarButton("blue").unfocusedUri, "pkg:/images/buttons/media-toolbar-button-unfocused.9.png")
            m.assertEqual(Theme.ToolbarButton("blue").focusedUri, "pkg:/images/buttons/media-toolbar-button-focused.9.png")
            m.assertEqual(Theme.ToolbarButton("liquid-glass").unfocusedUri, "pkg:/images/themes/liquid-glass/fhd/pill.9.png")
            m.assertEqual(Theme.ToolbarButton("cinema").focusedUri, "pkg:/images/themes/cinema/fhd/pill-focused.9.png")
        end function

        @it("renders original text inputs as rectangles and skins as panels")
        function _()
            m.assertEqual(Theme.TextInput("blue"), { panelUri: "", focusUri: "" })
            m.assertEqual(Theme.TextInput("cinema"), { panelUri: "pkg:/images/themes/cinema/fhd/input.9.png", focusUri: "pkg:/images/themes/cinema/fhd/input-focus.9.png" })
        end function

        @it("keeps the shared progress art for the original themes and swaps it for skins")
        function _()
            original = Theme.ProgressBar("pure-black")
            cinema = Theme.ProgressBar("cinema")

            m.assertEqual(original.trackUri, "pkg:/images/progress/progress-track.9.png")
            m.assertEqual(original.fillUri, "pkg:/images/progress/progress-fill.9.png")
            m.assertEqual(original.borderUri, "pkg:/images/progress/progress-border.9.png")
            m.assertEqual(cinema.fillUri, "pkg:/images/themes/cinema/fhd/progress-fill.9.png")
            m.assertEqual(cinema.borderUri, "")
        end function

        @it("returns the default focus frame for every theme but Cinema")
        function _()
            uri = "pkg:/images/homepage/fhd/home-page-thumbnail-focus.png"

            m.assertEqual(Theme.FocusFrameUri("blue", uri), uri)
            m.assertEqual(Theme.FocusFrameUri("liquid-glass", uri), uri)
        end function

        @it("re-corners focus frames for Cinema")
        function _()
            m.assertEqual(Theme.FocusFrameUri("cinema", "pkg:/images/homepage/fhd/home-page-thumbnail-focus.png"), "pkg:/images/themes/cinema/focus/fhd/home-page-thumbnail-focus.png")
            m.assertEqual(Theme.FocusFrameUri("cinema", "pkg:/images/tv-show/season-poster-focus-207x381.png"), "pkg:/images/themes/cinema/focus/shared/season-poster-focus-207x381.png")
        end function

        @it("re-corners only the known masks for Cinema")
        function _()
            posterMask = "pkg:/images/masks/fhd/poster-6-col-mask.png"

            m.assertEqual(Theme.MaskUri("liquid-glass", posterMask), posterMask)
            m.assertEqual(Theme.MaskUri("cinema", posterMask), "pkg:/images/themes/cinema/masks/fhd/poster-6-col-mask.png")
            m.assertEqual(Theme.MaskUri("cinema", "pkg:/images/masks/fhd/cast-mask.png"), "pkg:/images/masks/fhd/cast-mask.png")
        end function

        @it("keeps the shared media shell gradient for the original themes and fades skins full screen")
        function _()
            original = Theme.MediaShell("black")
            cinema = Theme.MediaShell("cinema")

            m.assertEqual(original, { backdropOpacity: 0.5, gradientUri: "pkg:/images/overlays/bottom-content-gradient.png", fullScreenGradient: false })
            m.assertEqual(cinema, { backdropOpacity: 0.75, gradientUri: "pkg:/images/themes/cinema/media-shell-gradient.png", fullScreenGradient: true })
            m.assertEqual(Theme.MediaShell("liquid-glass").backdropOpacity, 0.5)
        end function

        @it("colors playback progress red only for Cinema")
        function _()
            m.assertEqual(Theme.PlaybackControls("liquid-glass").fillColor, &hFFFFFFFF)
            m.assertEqual(Theme.PlaybackControls("liquid-glass").trackOpacity, 0.32)
            m.assertEqual(Theme.PlaybackControls("cinema").fillColor, &hE50914FF)
            m.assertEqual(Theme.PlaybackControls("cinema").trackColor, &h4D4D4DFF)
        end function

        @it("shows the billboard and bundles typefaces only for skins")
        function _()
            m.assertFalse(Theme.ShowsBillboard("blue"))
            m.assertTrue(Theme.ShowsBillboard("liquid-glass"))
            m.assertTrue(Theme.ShowsBillboard("cinema"))
            m.assertInvalid(Theme.Fonts("blue"))
            m.assertEqual(Theme.Fonts("liquid-glass"), { regular: "pkg:/fonts/liquid-glass/Inter-Regular.ttf", bold: "pkg:/fonts/liquid-glass/Inter-SemiBold.ttf", scale: 0.9 })
            m.assertEqual(Theme.Fonts("cinema"), { regular: "pkg:/fonts/cinema/Montserrat-Medium.ttf", bold: "pkg:/fonts/cinema/Montserrat-SemiBold.ttf", scale: 0.88 })
        end function

    end class

end namespace
